# Customer SMS verification (Twilio)
SMS_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
SMS_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
SMS_FROM_NUMBER=YOUR_TWILIO_PHONE_NUMBER

# Optional: email for password-reset and order notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_EMAIL_ADDRESS
SMTP_PASSWORD=YOUR_EMAIL_APP_PASSWORD
MAIL_FROM=YOUR_EMAIL_ADDRESS
ORDER_NOTIFICATION_EMAILS=
